msgid "GL Account"
msgstr "Tài khoản sổ cái"

msgid "GL account capturing cost differences on outside-processing operations."
msgstr "Tài khoản sổ cái ghi nhận chênh lệch chi phí của công đoạn gia công ngoài."

msgid "GL account capturing differences between applied and actual manufacturing overhead."
msgstr "Tài khoản sổ cái ghi nhận chênh lệch giữa chi phí sản xuất chung phân bổ và thực tế."

msgid "GL account capturing differences between BOM-expected and actual material consumed."
msgstr "Tài khoản sổ cái ghi nhận chênh lệch giữa lượng vật tư dự kiến theo BOM và lượng tiêu hao thực tế."

msgid "GL account capturing differences between routing-expected and actual labor/machine time."
msgstr "Tài khoản sổ cái ghi nhận chênh lệch giữa thời gian nhân công/máy dự kiến theo quy trình công nghệ và thực tế."

msgid "GL account capturing fixed-cost differences when actual lot size differs from planned."
msgstr "Tài khoản sổ cái ghi nhận chênh lệch chi phí cố định khi cỡ lô thực tế khác kế hoạch."

msgid "GL account credited to remove the asset's original cost when it is disposed."
msgstr "Tài khoản sổ cái ghi Có để loại bỏ nguyên giá tài sản khi thanh lý."

msgid "GL account credited when a supplier invoice is posted (AP balance)."
msgstr "Tài khoản sổ cái ghi Có khi ghi sổ hóa đơn nhà cung cấp (số dư phải trả)."

msgid "GL account credited when labor or machine cost is absorbed into a production job."
msgstr "Tài khoản sổ cái ghi Có khi chi phí nhân công hoặc máy được phân bổ vào lệnh sản xuất."

msgid "GL account credited when manufacturing overhead is absorbed into a production job."
msgstr "Tài khoản sổ cái ghi Có khi chi phí sản xuất chung được phân bổ vào lệnh sản xuất."

msgid "GL account debited to clear accumulated depreciation when an asset is disposed."
msgstr "Tài khoản sổ cái ghi Nợ để xóa khấu hao lũy kế khi thanh lý tài sản."

msgid "GL account debited when a customer invoice posts; cleared when the customer pays."
msgstr "Tài khoản sổ cái ghi Nợ khi ghi sổ hóa đơn khách hàng; được tất toán khi khách hàng thanh toán."

msgid "GL account debited when a fixed asset is acquired (purchase or capitalized cost)."
msgstr "Tài khoản sổ cái ghi Nợ khi ghi tăng tài sản cố định (chi phí mua hoặc vốn hóa)."

msgid "GL account for bank service charges and similar fees."
msgstr "Tài khoản sổ cái cho phí dịch vụ ngân hàng và các khoản phí tương tự."

msgid "GL account for interest income or expense."
msgstr "Tài khoản sổ cái cho thu nhập hoặc chi phí lãi."

msgid "GL account for purchase tax paid to suppliers (or reclaimable)."
msgstr "Tài khoản sổ cái cho thuế mua hàng trả cho nhà cung cấp (hoặc được khấu trừ)."

msgid "GL account for tax accrued under reverse-charge rules where the buyer self-assesses."
msgstr "Tài khoản sổ cái cho thuế phải nộp theo cơ chế chuyển nghĩa vụ thuế, do bên mua tự kê khai."

msgid "GL account for tax timing differences (e.g. accelerated tax depreciation vs. book depreciation)."
msgstr "Tài khoản sổ cái cho chênh lệch thời điểm ghi nhận thuế (ví dụ: khấu hao nhanh theo thuế so với khấu hao kế toán)."

msgid "GL account hit when physical counts differ from system inventory."
msgstr "Tài khoản sổ cái dùng khi số lượng kiểm kê thực tế khác tồn kho trên hệ thống."

msgid "GL account in the source company to debit for this intercompany transaction."
msgstr "Tài khoản sổ cái tại công ty nguồn để ghi Nợ cho giao dịch liên công ty này."

msgid "GL account in the target company to credit for this intercompany transaction."
msgstr "Tài khoản sổ cái tại công ty đích để ghi Có cho giao dịch liên công ty này."

msgid "GL account that absorbs sub-cent rounding differences on posting."
msgstr "Tài khoản sổ cái ghi nhận chênh lệch làm tròn dưới một xu khi ghi sổ."

msgid "GL account that captures the difference between standard cost and actual purchase cost."
msgstr "Tài khoản sổ cái ghi nhận chênh lệch giữa chi phí tiêu chuẩn và chi phí mua thực tế."

msgid "GL account that carries an asset's original acquisition cost — debited when acquired and credited at full gross cost when it is disposed or sold."
msgstr "Tài khoản sổ cái ghi nhận nguyên giá tài sản — ghi Nợ khi ghi tăng và ghi Có toàn bộ nguyên giá khi thanh lý hoặc bán."

msgid "GL account that holds the value of jobs in production until they post to finished goods."
msgstr "Tài khoản sổ cái ghi nhận giá trị các lệnh đang sản xuất cho đến khi kết chuyển sang thành phẩm."

msgid "GL account that holds the value of manufactured goods (Make items); debited on job completion, credited on shipment."
msgstr "Tài khoản sổ cái ghi nhận giá trị hàng sản xuất (mặt hàng Sản xuất); ghi Nợ khi hoàn thành lệnh sản xuất, ghi Có khi xuất hàng."

msgid "GL account that holds the value of purchased stock and components (Buy items); debited on receipt, credited on issue/shipment."
msgstr "Tài khoản sổ cái ghi nhận giá trị hàng tồn kho và linh kiện mua vào (mặt hàng Mua); ghi Nợ khi nhập kho, ghi Có khi xuất dùng/xuất hàng."

msgid "GL account used when a customer pays before an invoice is issued; cleared when the invoice posts."
msgstr "Tài khoản sổ cái dùng khi khách hàng trả tiền trước khi xuất hóa đơn; được tất toán khi ghi sổ hóa đơn."

msgid "GL account where early-payment discounts given to customers are recorded."
msgstr "Tài khoản sổ cái ghi nhận chiết khấu thanh toán sớm dành cho khách hàng."

msgid "GL account where early-payment discounts taken from suppliers are recorded."
msgstr "Tài khoản sổ cái ghi nhận chiết khấu thanh toán sớm được hưởng từ nhà cung cấp."

msgid "GL contra-asset account credited as depreciation posts each period and debited in full when the asset is sold or scrapped."
msgstr "Tài khoản điều chỉnh giảm tài sản trong sổ cái, ghi Có khi ghi sổ khấu hao mỗi kỳ và ghi Nợ toàn bộ khi bán hoặc loại bỏ tài sản."

msgid "GL contra-asset account that accumulates depreciation booked against fixed assets."
msgstr "Tài khoản điều chỉnh giảm tài sản trong sổ cái, tích lũy khấu hao đã ghi nhận cho tài sản cố định."

msgid "GL equity account (CTA reserve) that holds unrealized FX differences from re-translating foreign-currency balances at period-end; separate from realized FX gain/loss in P&L."
msgstr "Tài khoản vốn chủ sở hữu trong sổ cái (dự phòng CTA) ghi nhận chênh lệch tỷ giá chưa thực hiện từ đánh giá lại số dư ngoại tệ cuối kỳ; tách biệt với lãi/lỗ tỷ giá đã thực hiện trong báo cáo kết quả kinh doanh."

msgid "GL equity account where net income closes at fiscal year-end."
msgstr "Tài khoản vốn chủ sở hữu trong sổ cái nhận kết chuyển lợi nhuận ròng cuối năm tài chính."

msgid "GL expense account debited each period when depreciation posts."
msgstr "Tài khoản chi phí trong sổ cái ghi Nợ mỗi kỳ khi ghi sổ khấu hao."

msgid "GL expense account debited when an asset's carrying value is reduced by impairment, i.e. when its recoverable amount falls below net book value."
msgstr "Tài khoản chi phí trong sổ cái ghi Nợ khi giảm giá trị ghi sổ của tài sản do suy giảm giá trị, tức giá trị có thể thu hồi thấp hơn giá trị sổ sách thuần."

msgid "GL expense account for non-inventory purchases (supplies, services)."
msgstr "Tài khoản chi phí trong sổ cái cho mua hàng không quản lý tồn kho (vật dụng, dịch vụ)."

msgid "GL liability account credited for sales tax collected from customers."
msgstr "Tài khoản nợ phải trả trong sổ cái ghi Có cho thuế bán hàng thu từ khách hàng."

msgid "GL tie-out"
msgstr "Đối chiếu sổ cái"

msgid "GL Tie-Out"
msgstr "Đối chiếu sổ cái"

msgid "Go live right the first time — with our team alongside you"
msgstr "Vận hành thành công ngay từ lần đầu — với đội ngũ chúng tôi đồng hành"

