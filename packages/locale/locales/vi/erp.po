msgstr "Ai nhận thông báo khi báo giá điện tử được chấp nhận hoặc hết hạn?"

msgid "Who should receive notifications when a gauge goes out of calibration?"
msgstr "Ai nhận thông báo khi dụng cụ đo hết hiệu lực hiệu chuẩn?"

msgid "Who should receive notifications when a new suggestion is submitted?"
msgstr "Ai nhận thông báo khi đề xuất mới được gửi?"

msgid "Who should receive notifications when a RFQ is marked ready for quote?"
msgstr "Ai nhận thông báo khi RFQ sẵn sàng báo giá?"

msgid "Who should receive notifications when a sales job is completed?"
msgstr "Ai nhận thông báo khi lệnh sản xuất theo đơn bán hàng hoàn thành?"

msgid "Who should receive notifications when a sales rule violation is blocked or acknowledged?"
msgstr "Ai nhận thông báo khi vi phạm quy tắc bán hàng bị chặn hoặc xác nhận?"

msgid "Who should receive notifications when a supplier quote is submitted?"
msgstr "Ai nhận thông báo khi báo giá nhà cung cấp được gửi?"

msgid "Who should receive notifications when an inventory job is completed?"
msgstr "Ai nhận thông báo khi lệnh sản xuất nhập kho hoàn thành?"

msgid "Who you buy from."
msgstr "Các đối tác bạn mua hàng."

msgid "Who you sell to and at what price."
msgstr "Các khách hàng bạn bán và mức giá."

