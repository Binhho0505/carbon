msgid "3D Model"
msgstr "Mô hình 3D"

msgid "3h"
msgstr "3 giờ"

msgid "4h"
msgstr "4 giờ"

msgid "5 user minimum"
msgstr "tối thiểu 5 người dùng"

msgid "5-8 weeks"
msgstr "5-8 tuần"

msgid "52-week demand"
msgstr "Nhu cầu 52 tuần"

msgid "5MB file limit"
msgstr "Giới hạn tệp 5MB"

msgid "7D"
msgstr "7 ngày"

msgid "8D"
msgstr "8D"

msgid "9-12 weeks"
msgstr "9-12 tuần"

msgid "90D"
msgstr "90 ngày"

msgid "A \"must match\" rule on this process blocks these from sharing a batch"
msgstr "Quy tắc \"phải khớp\" của quy trình này ngăn các công đoạn này dùng chung một mẻ"

msgid "A 3D model the operator can turn around"
msgstr "Mô hình 3D mà nhân viên vận hành có thể xoay để xem"

msgid "A 4-digit PIN is generated when the operator is created."
msgstr "Mã PIN 4 chữ số được tạo khi tạo nhân viên vận hành."

msgid "A batch needs at least one operation. To break up the whole batch, use Dissolve instead."
msgstr "Một mẻ cần ít nhất một công đoạn. Để tách toàn bộ mẻ, hãy dùng Giải tán."

msgid "A Carbon-run data migration — you load your own data"
msgstr "Di chuyển dữ liệu do Carbon thực hiện — bạn tự nạp dữ liệu của mình"

msgid "A change notice tracks a controlled engineering or manufacturing change through review and implementation."
msgstr "Thông báo thay đổi theo dõi thay đổi kỹ thuật hoặc sản xuất có kiểm soát qua quá trình xem xét và triển khai."

msgid "A clearing account holding the value of goods received but not yet billed; the supplier invoice clears it."
msgstr "Tài khoản trung gian ghi nhận giá trị hàng đã nhận nhưng chưa có hóa đơn; hóa đơn nhà cung cấp sẽ tất toán tài khoản này."

msgid "A company connects to one Onshape at a time. Uninstall Onshape Government, then connect Onshape."
msgstr "Một công ty chỉ kết nối với một Onshape tại một thời điểm. Gỡ Onshape Government, rồi kết nối Onshape."

msgid "A company connects to one Onshape at a time. Uninstall Onshape, then connect Onshape Government."
msgstr "Một công ty chỉ kết nối với một Onshape tại một thời điểm. Gỡ Onshape, rồi kết nối Onshape Government."

msgid "A company that designs and builds its own finished products end to end (here, the shop building humanoid robots) rather than making parts to another company's specification."
msgstr "Công ty tự thiết kế và sản xuất toàn bộ thành phẩm của mình (ở đây là xưởng chế tạo robot hình người) thay vì chế tạo chi tiết theo thông số của công ty khác."

msgid "A company that sits at or above selected companies in the group hierarchy and receives their intercompany cancelling entries for consolidated reporting; it is never a party to the trade itself."
msgstr "Công ty nằm ở cùng cấp hoặc cấp cao hơn các công ty được chọn trong cơ cấu tập đoàn và nhận bút toán loại trừ nội bộ của các công ty đó để lập báo cáo hợp nhất; công ty này không tham gia giao dịch."

msgid "A company-defined extra field attached to a core table (customer, part, order); it shows on the record's form, saves alongside the built-in fields, and is queryable through the API."
msgstr "Trường bổ sung do công ty định nghĩa, gắn với bảng cốt lõi (khách hàng, chi tiết, đơn hàng); hiển thị trên biểu mẫu bản ghi, được lưu cùng các trường có sẵn và có thể truy vấn qua API."

msgid "A company-defined tag axis attached to journal lines so the same accounts can be sliced by location, department, or any custom axis without multiplying the chart of accounts."
msgstr "Chiều phân loại do công ty định nghĩa, gắn với các dòng nhật ký để phân tích cùng các tài khoản theo địa điểm, phòng ban hoặc chiều tùy chỉnh mà không cần mở rộng hệ thống tài khoản."

msgid "A company-scoped Discount or Markup, by percentage or fixed amount, that adjusts a line's price up or down when the line matches the rule's quantity, date, item, and customer conditions."
msgstr "Chiết khấu hoặc cộng giá trong phạm vi công ty, theo tỷ lệ phần trăm hoặc số tiền cố định, điều chỉnh giá dòng lên hoặc xuống khi dòng khớp các điều kiện về số lượng, ngày, mặt hàng và khách hàng của quy tắc."

msgid "A completed job's output, received into inventory at the job's actual accumulated WIP cost."
msgstr "Sản phẩm của lệnh sản xuất đã hoàn thành, được nhập kho theo chi phí sản xuất dở dang thực tế đã tích lũy của lệnh."

msgid "A consumable is a physical item used to make a part that can be used across multiple jobs"
msgstr "Vật tư tiêu hao là mặt hàng hữu hình dùng để sản xuất chi tiết và có thể sử dụng cho nhiều lệnh sản xuất"

msgid "A contractor is a supplier contact with particular abilities and available hours"
msgstr "Nhà thầu là người liên hệ của nhà cung cấp có các kỹ năng cụ thể và giờ làm việc khả dụng"

msgid "A custom solution to meet your needs"
msgstr "Giải pháp tùy chỉnh đáp ứng nhu cầu của bạn"

msgid "A customer contact and location are optional"
msgstr "Người liên hệ và địa điểm khách hàng là tùy chọn"

msgid "A customer contact and location are required"
msgstr "Bắt buộc có người liên hệ và địa điểm khách hàng"

msgid "A customer is a business or person who buys your parts or services."
msgstr "Khách hàng là doanh nghiệp hoặc cá nhân mua chi tiết hoặc dịch vụ của bạn."

msgid "A customer is created"
msgstr "Khách hàng được tạo"

msgid "A customer is deleted"
msgstr "Khách hàng bị xóa"

msgid "A customer must have at least one contact with an email address and at least one location with a country — plus a state, for US addresses — before its quotes, orders and invoices can be issued or posted. The mirror of the supplier requirement under Purchasing; no integration requires it today."
msgstr "Khách hàng phải có ít nhất một người liên hệ có địa chỉ email và ít nhất một địa điểm có quốc gia — cùng tiểu bang đối với địa chỉ tại Hoa Kỳ — trước khi có thể phát hành hoặc hạch toán báo giá, đơn hàng và hóa đơn. Yêu cầu này tương ứng với yêu cầu dành cho nhà cung cấp trong Mua hàng; hiện chưa có tích hợp nào yêu cầu điều này."

msgid "A customer's account manager changes"
msgstr "Người quản lý khách hàng thay đổi"

msgid "A customer's assignee changes"
msgstr "Người được giao phụ trách khách hàng thay đổi"

msgid "A customer's currency changes"
msgstr "Tiền tệ của khách hàng thay đổi"

msgid "A customer's name changes"
msgstr "Tên khách hàng thay đổi"

msgid "A customer's sales contact changes"
msgstr "Người liên hệ bán hàng của khách hàng thay đổi"

msgid "A customer's status changes"
msgstr "Trạng thái khách hàng thay đổi"

msgid "A customer's type changes"
msgstr "Loại khách hàng thay đổi"

msgid "A dated record proving a gauge was checked against a traceable standard; it passes unless a requires-action, -adjustment, or -repair flag is ticked, and resets the gauge's next-due date."
msgstr "Bản ghi có ngày tháng chứng minh dụng cụ đo đã được kiểm tra với chuẩn có thể truy xuất; kết quả đạt trừ khi đánh dấu cờ yêu cầu xử lý, điều chỉnh hoặc sửa chữa, đồng thời đặt lại ngày đến hạn tiếp theo của dụng cụ đo."

msgid "A dated window postings fall into; its close status moves Open → Locked → Closed, and a closed period is frozen against new postings."
msgstr "Khoảng thời gian xác định để ghi nhận bút toán; trạng thái khóa sổ chuyển từ Đang mở → Đã khóa → Đã đóng, và kỳ đã đóng không cho phép bút toán mới."

msgid "A depreciation method that charges a fixed percentage of remaining book value each period — heavier early, lighter later."
msgstr "Phương pháp khấu hao tính tỷ lệ cố định trên giá trị còn lại trên sổ sách mỗi kỳ — cao hơn lúc đầu, thấp hơn về sau."

msgid "A depreciation method that charges an equal amount each period across the asset's useful life."
msgstr "Phương pháp khấu hao phân bổ số tiền bằng nhau mỗi kỳ trong suốt thời gian sử dụng hữu ích của tài sản."

msgid "A different inspector is required"
msgstr "Bắt buộc có người kiểm tra khác"

#. placeholder {0}: file.name
msgid "A file named {0} already exists — delete or rename it first"
msgstr "Tệp tên {0} đã tồn tại — hãy xóa hoặc đổi tên tệp trước"

msgid "A firm customer commitment to deliver; fulfillment status splits across ship and invoice before reaching Completed."
msgstr "Cam kết chắc chắn với khách hàng về việc giao hàng; trạng thái thực hiện được theo dõi riêng cho xuất hàng và lập hóa đơn trước khi đạt trạng thái Đã hoàn thành."

msgid "A firm order to a supplier; status moves through receive and invoice before Completed as goods and bills arrive."
msgstr "Đơn đặt hàng chắc chắn gửi nhà cung cấp; trạng thái đi qua nhận hàng và lập hóa đơn trước khi Đã hoàn thành khi hàng và hóa đơn đến."

msgid "A formal acceptance / sign-off phase"
msgstr "Giai đoạn nghiệm thu / ký duyệt chính thức"

msgid "A gauge whose role is Master — the reference standard other gauges are calibrated against, rather than one used for routine checks."
msgstr "Dụng cụ đo có vai trò Chuẩn — chuẩn tham chiếu để hiệu chuẩn các dụng cụ đo khác, thay vì dùng để kiểm tra thường xuyên."

msgid "A issue record tracks quality issues and their resolution process."
msgstr "Bản ghi vấn đề theo dõi các vấn đề chất lượng và quá trình giải quyết."

msgid "A job is created"
msgstr "Lệnh sản xuất được tạo"

msgid "A job is deleted"
msgstr "Lệnh sản xuất bị xóa"

msgid "A job is put on hold"
msgstr "Lệnh sản xuất được tạm giữ"

msgid "A job is released"
msgstr "Lệnh sản xuất được phát hành"

msgid "A job operation is completed"
msgstr "Công đoạn của lệnh sản xuất được hoàn thành"

msgid "A job's assignee changes"
msgstr "Người được giao lệnh sản xuất thay đổi"

msgid "A job's deadline type changes"
msgstr "Loại hạn chót của lệnh sản xuất thay đổi"

msgid "A job's due date changes"
msgstr "Ngày đến hạn của lệnh sản xuất thay đổi"

msgid "A job's priority changes"
msgstr "Mức ưu tiên của lệnh sản xuất thay đổi"

msgid "A job's quantity changes"
msgstr "Số lượng của lệnh sản xuất thay đổi"

msgid "A job's scrap quantity changes"
msgstr "Số lượng phế phẩm của lệnh sản xuất thay đổi"

msgid "A job's start date changes"
msgstr "Ngày bắt đầu của lệnh sản xuất thay đổi"

msgid "A job's status changes"
msgstr "Trạng thái lệnh sản xuất thay đổi"

msgid "A line settles more than its invoice's open balance"
msgstr "Một dòng tất toán vượt quá số dư chưa thanh toán của hóa đơn"

#. placeholder {0}: label( operationInputLabelKey(operationId, batchInput), batchInput )
msgid "A list is wired into {0}, so this step runs once for each item and returns a list of results."
msgstr "Danh sách được nối vào {0}, nên bước này chạy một lần cho mỗi mục và trả về danh sách kết quả."

#. placeholder {0}: inputLabel(batch.input)
msgid "A list is wired into {0}, so this step runs once for each item in it — up to {MAX_LIST_ITEMS}."
msgstr "Danh sách được nối vào {0}, nên bước này chạy một lần cho mỗi mục trong danh sách — tối đa {MAX_LIST_ITEMS}."

msgid "A Make to Order component that gets its own job and routing inside the parent's build."
msgstr "Thành phần sản xuất theo đơn hàng có lệnh sản xuất và quy trình công nghệ riêng trong quá trình sản xuất mặt hàng cha."

msgid "A Make to Order component whose parts are issued together into the parent job — no separate build."
msgstr "Thành phần sản xuất theo đơn hàng có các chi tiết được xuất chung vào lệnh sản xuất mặt hàng cha — không sản xuất riêng."

msgid "A managed cloud-hosted version of Carbon"
msgstr "Phiên bản Carbon được quản lý và lưu trữ trên đám mây"

msgid "A managed version with all the advanced features"
msgstr "Phiên bản được quản lý với đầy đủ tính năng nâng cao"

msgid "A material is a physical item used to make a part that can be used across multiple jobs"
msgstr "Vật tư là mặt hàng hữu hình dùng để sản xuất chi tiết và có thể sử dụng cho nhiều lệnh sản xuất"

msgid "A measurement instrument (caliper, micrometer, pin gauge, CMM) tracked as a record and held to a recurring calibration schedule."
msgstr "Dụng cụ đo (thước cặp, panme, dưỡng chốt, CMM) được theo dõi bằng bản ghi và hiệu chuẩn theo lịch định kỳ."

msgid "A name is required to save a view"
msgstr "Bắt buộc nhập tên để lưu chế độ xem"

msgid "A negotiated price pinned for a specific item — by customer, customer type, or all customers — that replaces the base price outright, optionally with quantity breaks."
msgstr "Giá đã thỏa thuận cho một mặt hàng cụ thể — theo khách hàng, loại khách hàng hoặc mọi khách hàng — thay thế hoàn toàn giá cơ sở, có thể kèm các mức giá theo số lượng."

msgid "A new purchase order will be created for each supplier. Alternatively, you can choose an existing draft purchase order for the supplier to add the outside operations to."
msgstr "Đơn mua hàng mới sẽ được tạo cho mỗi nhà cung cấp. Bạn cũng có thể chọn đơn mua hàng nháp hiện có của nhà cung cấp để thêm các công đoạn thuê ngoài."

msgid "A new revision will be created using a copy of the current revision"
msgstr "Phiên bản sửa đổi mới sẽ được tạo từ bản sao phiên bản sửa đổi hiện tại"

msgid "A new size will be created using a copy of the current size"
msgstr "Kích thước mới sẽ được tạo từ bản sao kích thước hiện tại"

msgid "A new Stripe customer will be created"
msgstr "Khách hàng Stripe mới sẽ được tạo"

msgid "A non-cash document that settles an invoice against a reason account: a credit lowers what's owed, a debit raises it."
msgstr "Chứng từ phi tiền mặt tất toán hóa đơn vào tài khoản theo lý do: chứng từ ghi giảm làm giảm số tiền phải trả, chứng từ ghi tăng làm tăng số tiền phải trả."

msgid "A non-conformance shared with a supplier over a login-free /share/scar link, so they can respond to the issue and update its tasks from outside Carbon."
msgstr "Sự không phù hợp được chia sẻ với nhà cung cấp qua liên kết /share/scar không cần đăng nhập, để họ có thể phản hồi vấn đề và cập nhật nhiệm vụ từ bên ngoài Carbon."

msgid "A non-taxable surcharge (e.g. recoverable expenses like permit fees) added to the line; excluded from the tax base."
msgstr "Phụ phí không chịu thuế (ví dụ khoản chi được hoàn lại như phí giấy phép) được thêm vào dòng; không tính vào cơ sở tính thuế."

msgid "A nonconformance task that fixes a confirmed root cause — as opposed to a preventive or immediate containment action."
msgstr "Nhiệm vụ xử lý sự không phù hợp để khắc phục nguyên nhân gốc rễ đã xác nhận — khác với hành động phòng ngừa hoặc ngăn chặn tức thời."

msgid "A nonconformance task that stops the problem recurring elsewhere — distinct from the corrective fix and containment."
msgstr "Nhiệm vụ xử lý sự không phù hợp để ngăn vấn đề tái diễn ở nơi khác — khác với khắc phục và ngăn chặn."

msgid "A part contains the information about a specific item that can be purchased or manufactured."
msgstr "Chi tiết chứa thông tin về một mặt hàng cụ thể có thể mua hoặc sản xuất."

msgid "A part in this step may tip once placed — consider a fixture or a second person."
msgstr "Chi tiết trong bước này có thể bị lật sau khi đặt — hãy cân nhắc dùng đồ gá hoặc người hỗ trợ."

msgid "A photo or PDF the operator sees on this step"
msgstr "Ảnh hoặc PDF mà nhân viên vận hành xem ở bước này"

msgid "A physical pull signal — a printed card or QR code living with the stock — that raises a purchase order or a job the moment it's scanned to refill a bin."
msgstr "Tín hiệu kéo vật lý — thẻ in hoặc mã QR đi cùng hàng tồn kho — tạo đơn mua hàng hoặc lệnh sản xuất ngay khi được quét để bổ sung thùng chứa."

msgid "A point in one of Carbon's own flows that a workflow can watch — a job released, a quote accepted, a shipment posted — as opposed to a raw field change; it hands the workflow the records involved by id."
msgstr "Điểm trong luồng xử lý của Carbon mà quy trình tự động có thể theo dõi — lệnh sản xuất được phát hành, báo giá được chấp nhận, lô hàng xuất được hạch toán — khác với thay đổi trường dữ liệu thô; điểm này cung cấp ID các bản ghi liên quan cho quy trình tự động."

msgid "A posted accounting entry: a header plus balanced debit and credit lines against GL accounts."
msgstr "Bút toán kế toán đã hạch toán: phần đầu cùng các dòng Nợ và Có cân bằng trên các tài khoản sổ cái."

msgid "A posted cash transaction — a Receipt from a customer or a Disbursement to a supplier — applied to invoices through settlements, moving Draft → Posted → Voided."
msgstr "Giao dịch tiền đã hạch toán — khoản thu từ khách hàng hoặc khoản chi cho nhà cung cấp — được áp dụng vào hóa đơn qua tất toán, chuyển từ Bản nháp → Đã hạch toán → Đã hủy hiệu lực."

msgid "A pre-written description inserted into every issue that uses this workflow; placeholders like {itemId} and {location} are substituted at creation."
msgstr "Mô tả soạn sẵn được chèn vào mọi vấn đề sử dụng quy trình tự động này; các biến như {itemId} và {location} được thay thế khi tạo."

msgid "A priced sales quotation; Draft → Sent → Ordered, or ends Lost, Expired, or Cancelled."
msgstr "Báo giá bán hàng có giá; Bản nháp → Đã gửi → Đã đặt hàng, hoặc kết thúc ở Không thành công, Hết hạn hoặc Đã hủy."

msgid "A purchase invoice is a document that specifies the products or services purchased by a customer and the corresponding cost."
msgstr "Hóa đơn mua hàng là chứng từ ghi rõ sản phẩm hoặc dịch vụ khách hàng đã mua và chi phí tương ứng."

msgid "A purchase invoice is posted"
msgstr "Hóa đơn mua hàng được hạch toán"

msgid "A purchase order is created"
msgstr "Đơn mua hàng được tạo"

msgid "A purchase order is deleted"
msgstr "Đơn mua hàng bị xóa"

msgid "A purchase order's assignee changes"
msgstr "Người được giao đơn mua hàng thay đổi"

msgid "A purchase order's order date changes"
msgstr "Ngày đặt hàng của đơn mua hàng thay đổi"

msgid "A purchase order's status changes"
msgstr "Trạng thái đơn mua hàng thay đổi"

msgid "A purchase order's supplier changes"
msgstr "Nhà cung cấp của đơn mua hàng thay đổi"

msgid "A purchase order's supplier location changes"
msgstr "Địa điểm nhà cung cấp của đơn mua hàng thay đổi"

msgid "A purchase order's supplier reference changes"
msgstr "Tham chiếu nhà cung cấp của đơn mua hàng thay đổi"

msgid "A purchase order's tags changes"
msgstr "Nhãn của đơn mua hàng thay đổi"

msgid "A purchase order's type changes"
msgstr "Loại đơn mua hàng thay đổi"

msgid "A quality issue — a logged deviation or defect with a configurable workflow of investigation and action tasks."
msgstr "Vấn đề chất lượng — sai lệch hoặc lỗi được ghi nhận với quy trình tự động có thể cấu hình gồm các nhiệm vụ điều tra và xử lý."

msgid "A quantity of identical units shares one tracked entity and batch number — one entity, many units."
msgstr "Nhiều đơn vị giống nhau dùng chung một thực thể theo dõi và số mẻ — một thực thể, nhiều đơn vị."

