msgstr "Dòng hóa đơn bán hàng chứa chi tiết hóa đơn của một mặt hàng cụ thể"

msgid "A sales order contains information about the agreement between the company and a specific customer for parts and services."
msgstr "Đơn bán hàng chứa thông tin về thỏa thuận giữa công ty và một khách hàng cụ thể về chi tiết và dịch vụ."

msgid "A sales order is created"
msgstr "Đơn bán hàng được tạo"

msgid "A sales order is deleted"
msgstr "Đơn bán hàng bị xóa"

