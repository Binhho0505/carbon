msgid "Enable audit logging in settings to start tracking changes to your data."
msgstr "Bật ghi nhật ký kiểm toán trong thiết lập để bắt đầu theo dõi thay đổi dữ liệu."

msgid "Enable digital quotes for your company. This will allow you to send digital quotes to your customers, and allow them to accept them online."
msgstr "Bật báo giá điện tử cho công ty. Tính năng cho phép gửi báo giá điện tử cho khách hàng và để họ chấp nhận trực tuyến."

msgid "Enable full accrual accounting with journal entries, financial reports, and general ledger posting."
msgstr "Bật kế toán dồn tích đầy đủ với bút toán, báo cáo tài chính và hạch toán sổ cái."

msgid "Enable in Settings"
msgstr "Bật trong Thiết lập"

msgid "Enable notifications when a sales rule violation is blocked or acknowledged on a quote, sales order, or sales invoice."
msgstr "Bật thông báo khi vi phạm quy tắc bán hàng bị chặn hoặc được xác nhận trên báo giá, đơn bán hàng hoặc hóa đơn bán hàng."

msgid "Enable notifications when an RFQ is marked as ready for quote."
msgstr "Bật thông báo khi RFQ được đánh dấu sẵn sàng báo giá."

msgid "Enable shared workstation mode for MES terminals. Operators identify themselves via PIN before performing work."
msgstr "Bật chế độ trạm làm việc dùng chung cho thiết bị đầu cuối MES. Nhân viên vận hành xác định danh tính qua PIN trước khi làm việc."

msgid "Enable this rule to automatically require approval for matching documents"
msgstr "Bật quy tắc này để tự động yêu cầu phê duyệt cho chứng từ khớp điều kiện"

msgid "Enable timecard tracking for work shifts."
msgstr "Bật theo dõi bảng chấm công cho ca làm việc."

msgid "Enable to allow lowercase characters in item IDs."
msgstr "Bật để cho phép chữ thường trong ID mặt hàng."

msgid "Enable to allow shared workstation mode."
msgstr "Bật để cho phép chế độ trạm làm việc dùng chung."

msgid "Enable to automatically post transactions to the general ledger."
msgstr "Bật để tự động hạch toán giao dịch vào sổ cái."

msgid "Enable to block issuing or posting for a customer with no contact or no location."
msgstr "Bật để chặn phát hành hoặc hạch toán cho khách hàng thiếu người liên hệ hoặc địa điểm."

msgid "Enable to block issuing or posting for a supplier with no contact or no location."
msgstr "Bật để chặn phát hành hoặc hạch toán cho nhà cung cấp thiếu người liên hệ hoặc địa điểm."

msgid "Enable to configure tax-specific depreciation methods on asset classes (e.g., MACRS, accelerated)."
msgstr "Bật để cấu hình phương pháp khấu hao riêng cho thuế trên nhóm tài sản (ví dụ MACRS, khấu hao nhanh)."

msgid "Enable to generate IDs and descriptions for raw materials."
msgstr "Bật để tạo ID và mô tả cho nguyên vật liệu."

msgid "Enable to require an authenticator app before anyone can open this company."
msgstr "Bật để yêu cầu ứng dụng xác thực trước khi bất kỳ ai mở công ty này."

msgid "Enable to route all AP invoices to a single billing address."
msgstr "Bật để chuyển mọi hóa đơn phải trả đến một địa chỉ nhận hóa đơn duy nhất."

msgid "Enable to route all AR invoices to a single billing address."
msgstr "Bật để chuyển mọi hóa đơn phải thu đến một địa chỉ nhận hóa đơn duy nhất."

msgid "Enable to show a readable Customer ID on lists, forms and dropdowns."
msgstr "Bật để hiển thị ID khách hàng dễ đọc trên danh sách, biểu mẫu và danh sách thả xuống."

msgid "Enable to show a readable Supplier ID on lists, forms and dropdowns."
msgstr "Bật để hiển thị ID nhà cung cấp dễ đọc trên danh sách, biểu mẫu và danh sách thả xuống."

msgid "Enable to show the item ID and revision instead of the description."
msgstr "Bật để hiển thị ID mặt hàng và phiên bản sửa đổi thay cho mô tả."

msgid "Enable to start tracking changes to your data."
msgstr "Bật để bắt đầu theo dõi thay đổi dữ liệu."

msgid "Enable to start tracking work shifts."
msgstr "Bật để bắt đầu theo dõi ca làm việc."

msgid "Enable to update part lead times from posted purchase receipts."
msgstr "Bật để cập nhật thời gian cung ứng chi tiết từ phiếu nhập mua hàng đã hạch toán."

msgid "Enable to use metric units for material dimensions."
